{
  "Primitives": {
    "Color": {
      "brand":    { "$type": "color", "$value": "#7B2FF7", "source": "user_explicit" },
      "neutral-0":   { "$type": "color", "$value": "#FAFAFA", "source": "ai_inferred" },
      "neutral-900": { "$type": "color", "$value": "#111111", "source": "ai_inferred" },
      "neutral-950": { "$type": "color", "$value": "#121212", "source": "ai_inferred" },
      "neutral-50":  { "$type": "color", "$value": "#EDEDED", "source": "ai_inferred" }
    },
    "Font": {
      "family-body": { "$type": "fontFamily", "$value": "Satoshi, system-ui, sans-serif", "source": "ai_inferred" }
    }
  },
  "Layout": {
    "Space": {
      "2": { "$type": "dimension", "$value": "8px", "source": "ai_inferred" },
      "4": { "$type": "dimension", "$value": "16px", "source": "ai_inferred" }
    },
    "Radius": {
      "md": { "$type": "dimension", "$value": "8px", "source": "ai_inferred" }
    }
  },
  "Color": {
    "bg-default":   { "$type": "color", "$value": "{Primitives.Color.neutral-0}",   "$extensions": { "mode": { "dark": "{Primitives.Color.neutral-950}" } }, "source": "ai_inferred" },
    "text-primary": { "$type": "color", "$value": "{Primitives.Color.neutral-900}", "$extensions": { "mode": { "dark": "{Primitives.Color.neutral-50}" } },  "source": "ai_inferred" },
    "accent":       { "$type": "color", "$value": "{Primitives.Color.brand}", "source": "user_explicit" }
  },
  "Typography": {
    "text-sm": { "$type": "dimension", "$value": "0.875rem", "source": "ai_inferred" },
    "text-md": { "$type": "dimension", "$value": "1rem", "source": "ai_inferred" }
  }
}
